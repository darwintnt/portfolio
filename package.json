{
  "name": "portfolio-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,vue,json,css,scss,md,html}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,vue,json,css,scss,md,html}\"",
    "i18n:validate": "node scripts/validate-translations.js",
    "sitemap:generate": "node scripts/generate-sitemap.js",
    "prebuild": "npm run sitemap:generate",
    "prepare": "husky install"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@unhead/vue": "^3.1.6",
    "unhead": "^3.1.6",
    "v-lazy-image": "^2.1.1",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "autoprefixer": "^10.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "vite": "^8.1.0",
    "vite-svg-loader": "^5.1.1"
  },
  "lint-staged": {
    "*.{js,ts,vue,css,scss,md,json,html}": [
      "prettier --write"
    ]
  }
}
